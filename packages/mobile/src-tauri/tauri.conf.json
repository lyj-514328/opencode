{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Mobile",
  "version": "0.1.0",
  "identifier": "app.opencodemobile",
  "build": {
    "frontendDist": "../webui",
    "beforeBuildCommand": "bun run webui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenCode",
        "width": 430,
        "height": 900,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
